# ============================================
# Configuración del frontend BAS Pet Shop
# ============================================
# Copiá este archivo a .env.local y ajustá los valores reales.
#
# Las credenciales de administrador NO van acá: el login admin se hace
# contra el backend vía POST /auth/admin/login (email + contraseña), que
# devuelve un token JWT y el usuario. Lo mismo aplica al login con Google
# (GET /auth/google redirige al callback).

# URL base del backend (REST API).
# El cliente Axios y el proxy de Vite usan NEXT_PUBLIC_API_URL con
# prioridad, y VITE_API_URL como alternativa.
VITE_API_URL=https://backendexample.com/api

# (Opcional) Variable alternativa usada por el proxy de Vite en desarrollo.
# Si la definís, tiene prioridad sobre VITE_API_URL.
# NEXT_PUBLIC_API_URL=https://backendexample.com/api

